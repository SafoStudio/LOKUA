{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "typeorm": "typeorm-ts-node-esm",
    "m:gen": "pnpm typeorm migration:generate -d src/db/data-source.ts",
    "m:run": "pnpm typeorm migration:run -d src/db/data-source.ts",
    "m:revert": "pnpm typeorm migration:revert -d src/db/data-source.ts",
    "m:drop": "pnpm typeorm schema:drop -d src/db/data-source.ts",
    "m:show": "pnpm typeorm migration:show -d src/db/data-source.ts",
    "m:run:prod": "typeorm migration:run -d dist/db/data-source.js"
  },
  "dependencies": {
    "@simplewebauthn/server": "^14.0.3",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "google-auth-library": "^11.3.3",
    "helmet": "^8.3.0",
    "jose": "^6.2.15",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "pino-pretty": "^13.2.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  }
}
