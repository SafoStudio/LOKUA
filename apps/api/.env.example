NODE_ENV=development
PORT=3003
# BIND_HOST=127.0.0.1
TRUST_PROXY_HOPS=0
LOG_LEVEL=info
LOG_HTTP=false
DB_LOGGING=false
APP_URL=http://localhost:3003
CLIENT_URL=http://localhost:5173
DATABASE_URL=postgres://lokua:lokua@localhost:5432/lokua
# prod: pooled connection (Neon) for runtime, direct — for migrations.
# Migrations in prod: DATABASE_URL=<direct_url> pnpm m:run:prod
DATABASE_URL_DIRECT=postgres://lokua:lokua@localhost:5432/lokua
# NOMINATIM_BASE_URL=https://geocoder.example.com

JWT_ACCESS_SECRET=dev_access_secret_change_me_at_least_32_chars
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_at_least_32_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
GOOGLE_REDIRECT_URI=http://localhost:3003/api/v1/auth/google/callback
GOOGLE_SUCCESS_REDIRECT=http://localhost:5173/auth/callback

WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=LOKUA
WEBAUTHN_ORIGIN=http://localhost:5173

BREVO_SMTP_USER=...
BREVO_SMTP_KEY=xsmtpsib-...
BREVO_SENDER_EMAIL=noreply@lokua.app
# Remove this setting in production to use Brevo.
LOCAL_SMTP_PORT=1025

# Storage: dev — MinIO, prod — Cloudflare R2 (S3-compatible)
# MinIO (dev):
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=lokua-uploads
STORAGE_ACCESS_KEY_ID=lokua
STORAGE_SECRET_ACCESS_KEY=lokua_secret
# Set a stable secret in production so rotating JWT secrets does not invalidate image URLs.
# STORAGE_IMAGE_SIGNING_SECRET=replace_with_a_stable_secret_of_32_or_more_characters
STORAGE_FORCE_PATH_STYLE=true
STORAGE_SIGNED_URL_TTL=900
STORAGE_MAX_UPLOAD_BYTES=10485760
# R2 (prod):
# STORAGE_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# STORAGE_REGION=auto
# STORAGE_BUCKET=lokua-uploads
# STORAGE_ACCESS_KEY_ID=...
# STORAGE_SECRET_ACCESS_KEY=...
# STORAGE_FORCE_PATH_STYLE=false
# STORAGE_SIGNED_URL_TTL=900
# STORAGE_MAX_UPLOAD_BYTES=10485760

# Local test database and smoke overrides
TEST_DATABASE_URL=postgres://lokua:lokua@localhost:5433/lokua_test
# SMOKE_LIFECYCLE_DATABASE_URL=postgres://lokua:lokua@localhost:5433/lokua_test
# SMOKE_LIFECYCLE_PORT=3004
# SMOKE_MAILPIT_URL=http://127.0.0.1:8025
# SMOKE_EVENT_ID=
